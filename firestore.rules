rules_version = '2';

// Omega Dental — Firestore security rules.
//
// Paste these into: Firebase Console → Build → Firestore Database → Rules → Publish.
// This file is a reference copy kept in the repo; it is NOT deployed automatically
// (the site is static and has no Firebase CLI deploy step).
//
// The intent: anyone on the website can SUBMIT a booking, but only the signed-in
// clinic owner can READ or UPDATE them — booking documents contain patient names
// and phone numbers, so they must never be publicly readable.

service cloud.firestore {
  match /databases/{database}/documents {

    match /bookings/{bookingId} {
      // A visitor submitting the booking form on book.html, or the "Request a
      // Free Callback" form on the homepage. Both write here on purpose: this is
      // the only collection a visitor may create in, and the dashboard already
      // renders it. Callbacks are marked with kind:"callback".
      allow create: if true;

      // Only a signed-in user (the owner's Email/Password account) may read them.
      // Bookings hold patient names and phone numbers, so they must never be
      // publicly readable.
      allow read: if request.auth != null;

      // Nothing edits or removes a booking any more. The dashboard panel is
      // read-only — every booking is captured by the alert email and the bookings
      // spreadsheet — so a submitted request is now immutable from the web.
      allow update, delete: if false;
    }

    // Patient visit records created in the dashboard (walk-ins and website
    // bookings that were added to records). Unlike bookings there is NO public
    // create here — this is patient history, readable and writable only by the
    // signed-in clinic account.
    match /records/{recordId} {
      allow read, write: if request.auth != null;
    }

    // The four figures on the homepage (Happy Patients, Years Experience, Services
    // Available, Satisfaction). The clinic edits them in the dashboard; every visitor's
    // browser reads them, so read is public. Nothing here is patient data — it is the
    // same four numbers already printed on the page.
    match /site/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Nothing else in the project is reachable from the web client.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
